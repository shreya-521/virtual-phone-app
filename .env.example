# Environment Configuration Template (DO NOT COMMIT REAL SECRETS)
PORT=3000
NODE_ENV=production

# Telephony API Credentials (Optional - for Twilio/Telnyx integration)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15550100

# Rate Limiting & Auth Configuration
FREE_TIER_RATE_LIMIT=10
PAID_TIER_RATE_LIMIT=100
DAILY_CAP_LIMIT=500
